FROM 766267172432.dkr.ecr.us-east-1.amazonaws.com/nemo-autobot/agent-sandbox@sha256:3b951a90a09456bd50c90c956f10bf96ca103efe810af6bfe51f0a90c7aadf0b
WORKDIR /opt/nemo-gym
USER root
RUN <<'SYSTEM' bash -euxo pipefail
# Resolve the native CI package list from this exact checkout, without changing
# package versions or installing a different framework stack. Docker is CLI-only.
eval "$(sed -n '/^packages=(/,/^)/p' scripts/ci/install_test_dependencies.sh)"
apt-get update
apt-get --simulate install --no-install-recommends "${packages[@]}" docker.io
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}" docker.io
dpkg-query -W "${packages[@]}" docker.io
apt-get clean
rm -rf /var/lib/apt/lists/*
SYSTEM
ENV TIKTOKEN_CACHE_DIR=/opt/nemo-gym/cache/tiktoken
ENV npm_config_prefix=/home/nemo-runtime/.local
USER 65532:65532
RUN <<'PREPARE' bash -euxo pipefail
export HOME=/home/nemo-runtime XDG_CACHE_HOME=/opt/nemo-gym/cache/xdg
export UV_OFFLINE=0 HF_HUB_OFFLINE=0
mkdir -p "$TIKTOKEN_CACHE_DIR" "$HOME/.local/bin"
test -w "$HOME"; test -w "$UV_CACHE_DIR"; test -w "$TIKTOKEN_CACHE_DIR"
# Fresh native server environments, only to prepare their real lazy consumers.
python -u - <<'PY'
from nemo_gym.cli.env import TestConfig, _setup_single
from nemo_gym.config.global_config import get_global_config_dict
config = get_global_config_dict()
for entrypoint in ('resources_servers/moldetox', 'resources_servers/interactive_browser', 'resources_servers/rna_design', 'resources_servers/chemcotbench', 'resources_servers/instruction_following', 'resources_servers/wmt_translation'):
    print('PREPARE_NATIVE_ENV', entrypoint, flush=True)
    status = _setup_single(TestConfig(entrypoint=entrypoint), config).wait()
    if status:
        raise SystemExit(status)
PY
# Tokenizer downloads are verified by the hashes in the installed tiktoken package.
python -c 'import tiktoken; [tiktoken.get_encoding(n).encode("offline readiness") for n in ("cl100k_base", "o200k_base")]'
resources_servers/moldetox/.venv/bin/python -c 'from rdkit.Chem.Draw import rdMolDraw2D; print("RDKIT_DRAW_IMPORT_OK")'
(cd resources_servers/interactive_browser && .venv/bin/python -c 'from browser._chromium import ensure_chromium; ensure_chromium()')
resources_servers/rna_design/.venv/bin/python -c 'from responses_api_agents.rna_design_agent.prepare import ensure_suites; ensure_suites()'
resources_servers/instruction_following/.venv/bin/python -c 'from resources_servers.instruction_following.setup_indicifeval import load_harness; load_harness()'
resources_servers/wmt_translation/.venv/bin/python -c 'from sacrebleu.metrics import BLEU; print(BLEU(tokenize="flores200").corpus_score(["offline probe"], [["offline probe"]]))'
# These are the native pinned source, data, Python-3.11 runtime and oracle installers.
resources_servers/chemcotbench/.venv/bin/python -c 'from resources_servers.chemcotbench.setup_upstream import ensure_repository, ensure_data; from resources_servers.chemcotbench.setup_molopt import ensure_molopt_runtime; print(ensure_repository(None)); print(ensure_data(None)); print(ensure_molopt_runtime())'
# The fixture deliberately creates its own isolated MCP-v2 environment.
uv --no-config venv /tmp/miniswe-native-seed --python 3.13.14
uv --no-config pip install --python /tmp/miniswe-native-seed/bin/python -r responses_api_agents/miniswe_sandboxed_agent/runtime/requirements.txt
UV_OFFLINE=1 /tmp/miniswe-native-seed/bin/python -c 'import minisweagent, litellm, mcp; print("MINISWE_RUNTIME_IMPORT_OK")'
rm -rf /tmp/miniswe-native-seed
# Reuse the native Node version and installer, then expose the real executable.
python -c 'from responses_api_agents.codex_agent.setup_codex import ensure_node; ensure_node()'
# Make source-relative generated inputs exportable to the materialized candidate.
tar -czf /opt/nemo-gym/cache/server-source-fixtures.tar.gz \
    responses_api_agents/rna_design_agent/suites \
    resources_servers/instruction_following/.indicifeval_trans
rm -rf resources_servers/moldetox/.venv resources_servers/interactive_browser/.venv \
    resources_servers/rna_design/.venv resources_servers/chemcotbench/.venv \
    resources_servers/instruction_following/.venv resources_servers/wmt_translation/.venv
PREPARE
ENV PATH=/home/nemo-runtime/.local/bin:/opt/nemo-gym/responses_api_agents/codex_agent/.codex_node/bin:/opt/nemo_gym_venv/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
RUN <<'NODE' bash -euxo pipefail
export HOME=/home/nemo-runtime
node --version
npm --version
# Exact version from the selected native pi_agent config; never use latest.
python -c 'from responses_api_agents.pi_agent.setup_pi import ensure_pi; ensure_pi("0.80.2")'
NODE
# Fresh offline processes probe the persisted cache rather than in-process state.
RUN <<'OFFLINE' bash -euxo pipefail
export HOME=/home/nemo-runtime UV_OFFLINE=1 HF_HUB_OFFLINE=1
python -c 'import ctypes; ctypes.CDLL("libXrender.so.1"); print("XRENDER_LOAD_OK")'
python -c 'import tiktoken.load; tiktoken.load.read_file = lambda *_: (_ for _ in ()).throw(RuntimeError("network forbidden")); import tiktoken; [print(n, tiktoken.get_encoding(n).encode("offline readiness")) for n in ("cl100k_base", "o200k_base")]'
uv --no-config venv /tmp/miniswe-native-offline --python 3.13.14
uv --offline --no-config pip install --python /tmp/miniswe-native-offline/bin/python -r responses_api_agents/miniswe_sandboxed_agent/runtime/requirements.txt
/tmp/miniswe-native-offline/bin/python -c 'import minisweagent, litellm, mcp; print("MINISWE_OFFLINE_OK")'
rm -rf /tmp/miniswe-native-offline
tar -tzf /opt/nemo-gym/cache/server-source-fixtures.tar.gz > /tmp/source-fixtures.list
test -s /tmp/source-fixtures.list
node --version
pi --version
docker --version
OFFLINE
