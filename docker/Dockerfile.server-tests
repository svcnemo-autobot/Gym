if not offline:
    run('eternafold-prepare', 'responses_api_agents/rna_design_agent', r"""
import os
from pathlib import Path
from responses_api_agents.rna_design_agent.setup_eternafold import ensure_eternafold
path = Path(os.environ['ARNIEFILE'])
assert ensure_eternafold(path.parent) == path
""", timeout=1800)
for component in ('resources_servers/rna_design', 'responses_api_agents/rna_design_agent'):
    run('rna-' + component.split('/')[0], component, r"""
