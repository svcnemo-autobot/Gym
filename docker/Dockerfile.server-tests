FROM 766267172432.dkr.ecr.us-east-1.amazonaws.com/gym@sha256:002570aa079073804098f23f25e4b736e65a902b919b10848c182980c7ac5ce8

# Runtime-only extension of the successful main image; keep this out of the product PR.
# Native source inputs at bfb4698986757fe067274d21289df5dcadc26f01:
# Complete native setup/lock manifest SHA256: eda22e448805e0db2bcf6b4c74c09213fcf1a295c7c316129beb626ab57bfc35
# scripts/ci/install_test_dependencies.sh: 693089cca8fd75a9d52f935fd0d23ee3c039e49f
# scripts/ci/setup_dev.sh: 1fc9d9839b03d410a3aeb7c1236a6e52b4c6a0da
# nemo_gym/cli/env.py: a29b93b067b94ddca202555e8b65278a0213ffee
# nemo_gym/orchestration/server_venv.py: 7e92e7f39d9ba6175d0393a4371bee10ce90938f
# resources_servers/interactive_browser/uv.lock: 53eefefa8525cbf33f67b80a1754326dc80add5b
USER root
COPY --chown=65532:65532 --exclude=docker/Dockerfile.server-tests . /opt/nemo-gym
WORKDIR /opt/nemo-gym
ENV HOME=/home/nemo-runtime
ENV PLAYWRIGHT_BROWSERS_PATH=/home/nemo-runtime/.cache/ms-playwright
ENV TIKTOKEN_CACHE_DIR=/home/nemo-runtime/.cache/tiktoken
ENV ARNIEFILE=/opt/nemo-gym/cache/server-test-runtime/eternafold/arniefile.txt
ENV PATH="/opt/nemo-gym/responses_api_agents/codex_agent/.codex_node/bin:/opt/nemo-gym/resources_servers/mimo_music/.abcmidi/bin:${PATH}"

# Fail cheap path assumptions before populating hundreds of component environments.
RUN <<'EOF' bash -eu -o pipefail
python - <<'PY_DRIVER'
import json, os, sys
from pathlib import Path
assert Path(sys.prefix) == Path('/opt/nemo_gym_venv'), (sys.executable, sys.prefix)
assert os.environ['UV_PROJECT_ENVIRONMENT'] == '/opt/nemo_gym_venv'
assert Path(os.environ['UV_CACHE_DIR']).is_dir()
print(json.dumps({'driver': sys.executable, 'prefix': sys.prefix,
                  'UV_PROJECT_ENVIRONMENT': os.environ['UV_PROJECT_ENVIRONMENT'],
                  'UV_CACHE_DIR': os.environ['UV_CACHE_DIR']}), flush=True)
PY_DRIVER
EOF

# Use the native CI installer's package list and Ubuntu's signed resolver, without sudo.
RUN <<'EOF' bash -eu -o pipefail
mapfile -t packages < <(python - <<'PY'
from pathlib import Path
import ast
import re
import shlex
source = Path('scripts/ci/install_test_dependencies.sh').read_text()
match = re.search(r'^packages=\(\n(.*?)^\)', source, re.M | re.S)
assert match, 'Native CI package list not found'
packages = shlex.split(match.group(1))
tree = ast.parse(Path('resources_servers/gdpval/setup_libreoffice.py').read_text())
for node in tree.body:
    if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == '_APT_PACKAGES' for t in node.targets):
        packages.extend(ast.literal_eval(node.value))
packages.extend(['tmux'])  # Real terminus_2_sandboxed_agent/tests/test_terminal.py sessions.
print('\n'.join(dict.fromkeys(packages)))
PY
)
test "${#packages[@]}" -gt 0
apt-get update
apt-get --simulate install --no-install-recommends "${packages[@]}"
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
mkdir -p /opt/nemo-gym/cache/server-test-runtime
dpkg-query -W > /opt/nemo-gym/cache/server-test-runtime/os-packages.tsv
rm -rf /var/lib/apt/lists/*
EOF

# Check one component's actual prefix before the expensive seeding layer.
RUN <<'EOF' bash -eu -o pipefail
export UV_OFFLINE=0
uv pip install --no-deps -e /opt/nemo-gym
python - <<'PY_CHEAP_COMPONENT'
import os, subprocess, sys
from pathlib import Path
sys.argv = ['runtime-path-preflight', '+uv_venv_dir=/opt/nemo-gym/cache/asset-envs', f'+uv_cache_dir={os.environ["UV_CACHE_DIR"]}']
from nemo_gym.cli.env import TestConfig, _setup_single
from nemo_gym.config.global_config import get_global_config_dict
from nemo_gym.orchestration.server_venv import get_venv_path
config = get_global_config_dict()
component = TestConfig(entrypoint='resources_servers/interactive_browser')
assert _setup_single(component, config).wait() == 0
venv = get_venv_path(component.resolved_dir_path, config)
subprocess.run([str(venv / 'bin/python'), '-c',
    'import sys; from pathlib import Path; assert Path(sys.prefix) == Path(sys.argv[1]); import playwright; print(sys.executable, sys.prefix)', str(venv)], check=True)
PY_CHEAP_COMPONENT
EOF

# Cache this expensive success separately from lazy assets and their probes.
RUN <<'EOF' bash -eu -o pipefail
export UV_OFFLINE=0
uv python install 3.11
seed_root=$(mktemp -d)
ng_test_all +setup_only=true +delete_venvs_after_each_test=true "+uv_cache_dir=${UV_CACHE_DIR}" "+uv_venv_dir=${seed_root}"
rm -rf "${seed_root}"
chown -R 65532:65532 /opt/nemo-gym/cache
EOF

# Bind actual component interpreters; never synchronize the inherited root environment.
RUN <<'EOF' bash -eu -o pipefail
export UV_OFFLINE=0
python - <<'PY_ENVIRONMENTS'
import json
import os
import subprocess
import sys
from pathlib import Path
sys.argv = ['runtime-asset-setup', '+uv_venv_dir=/opt/nemo-gym/cache/asset-envs', f'+uv_cache_dir={os.environ["UV_CACHE_DIR"]}']
from nemo_gym.cli.env import TestConfig, _setup_single
from nemo_gym.config.global_config import get_global_config_dict
from nemo_gym.orchestration.server_venv import get_venv_path
config = get_global_config_dict()
components = [
 'resources_servers/arena', 'resources_servers/genrm_eval', 'resources_servers/long_transduction',
 'resources_servers/instruction_following', 'resources_servers/ifbench',
 'resources_servers/voicebench', 'resources_servers/iheval', 'resources_servers/rolemrc',
 'resources_servers/chemcotbench', 'resources_servers/ether0',
 'resources_servers/interactive_browser', 'resources_servers/newton_bench',
 'resources_servers/rna_design', 'responses_api_agents/rna_design_agent',
 'resources_servers/mimo_music', 'responses_api_agents/codex_agent',
 'responses_api_agents/miniswe_sandboxed_agent', 'responses_api_models/switchyard_model',
 'resources_servers/gdpval', 'environment_servers/swe_together',
]
interpreters = {}
failed = []
for entrypoint in components:
    component = TestConfig(entrypoint=entrypoint)
    if _setup_single(component, config).wait() != 0:
        failed.append(entrypoint)
    else:
        venv = get_venv_path(component.resolved_dir_path, config)
        interpreter = venv / 'bin/python'
        subprocess.run([str(interpreter), '-c',
            'import sys; from pathlib import Path; assert Path(sys.prefix) == Path(sys.argv[1]); print(sys.executable, sys.prefix)', str(venv)], check=True)
        interpreters[entrypoint] = str(interpreter)
# The generator's extra package is pinned by its native benchmark lock.
import tomllib
lock = tomllib.loads(Path('benchmarks/long_transduction/uv.lock').read_text())
version = next(package['version'] for package in lock['package'] if package['name'] == 'wonderwords')
subprocess.run(['uv', 'pip', 'install', '--python', interpreters['resources_servers/long_transduction'], '--no-deps', f'wonderwords=={version}'], check=True)
Path('cache/server-test-runtime/interpreters.json').write_text(json.dumps(interpreters, indent=2))
assert not failed, failed
PY_ENVIRONMENTS
chown -R 65532:65532 /opt/nemo-gym/cache /home/nemo-runtime
EOF

# Only native helper calls and dependency probes; no pytest or test rewriting.
RUN <<'EOF' bash -eu -o pipefail
cat > /opt/nemo-gym/cache/server-test-runtime/native-assets.py <<'PY_ASSETS'
import json
import os
import subprocess
import sys
import traceback
from pathlib import Path
ROOT = Path('/opt/nemo-gym')
STATE = ROOT / 'cache/server-test-runtime'
interpreters = json.loads((STATE / 'interpreters.json').read_text())
mode = sys.argv[1]
offline = mode == 'offline'
os.environ['UV_OFFLINE'] = '1' if offline else '0'
os.environ['HF_HUB_OFFLINE'] = '1' if offline else '0'
# The offline process has no usable external route; local subprocess/lifecycle probes still work.
if offline:
    for key in ('HTTP_PROXY', 'HTTPS_PROXY', 'ALL_PROXY', 'http_proxy', 'https_proxy', 'all_proxy'):
        os.environ[key] = 'http://127.0.0.1:9'
    os.environ['NO_PROXY'] = os.environ['no_proxy'] = '127.0.0.1,localhost'

def run(name, component, code, cwd=ROOT, timeout=1200):
    try:
        subprocess.run([interpreters[component], '-u', '-c', code], cwd=cwd, check=True, timeout=timeout)
        result = {'group': name, 'mode': mode, 'status': 'passed'}
    except Exception as error:
        traceback.print_exc()
        result = {'group': name, 'mode': mode, 'status': 'failed', 'error': str(error)}
    with (STATE / f'{mode}.jsonl').open('a') as stream:
        stream.write(json.dumps(result) + '\n')
    results.append(result)

results = []
for component in ('resources_servers/arena', 'resources_servers/genrm_eval', 'resources_servers/long_transduction'):
    run('tokenizers-' + component.rsplit('/', 1)[1], component, r"""
import inspect
import tiktoken
import tiktoken.load
assert 'TIKTOKEN_CACHE_DIR' in inspect.getsource(tiktoken.load.read_file_cached)
for encoding in (tiktoken.encoding_for_model('gpt-4o'), tiktoken.get_encoding('cl100k_base')):
    assert encoding.decode(encoding.encode('Gym offline consumer')) == 'Gym offline consumer'
""")

run('long-transduction-vocabulary', 'resources_servers/long_transduction', r"""
from benchmarks.long_transduction.prepare import _load_word_lists
adjectives, nouns = _load_word_lists()
assert adjectives and nouns
""")

run('indicifeval', 'resources_servers/instruction_following', r"""
from resources_servers.instruction_following.setup_indicifeval import load_harness, LANGUAGES
from resources_servers.instruction_following.indicifeval import IndicIFEvalMetadata, score_response
load_harness()
for language in LANGUAGES:
    metadata = IndicIFEvalMetadata(language=language, prompt='Use a title and no comma.', instruction_id_list=['detectable_format:title', 'punctuation:no_comma'], kwargs=[{}, {}])
    assert score_response(metadata, '<<शीर्षक>>\nउत्तर').inst_level_strict_acc == [True, True]
""")

# Run NLTK's downloader only during preparation, into a private runtime-owned default root.
if not offline:
    run('nltk-prepare', 'resources_servers/ifbench', r"""
import defusedxml.ElementTree
import regex
import nltk
from pathlib import Path
root = Path.home() / 'nltk_data'
root.mkdir(mode=0o700, exist_ok=True)
for name in ('punkt', 'punkt_tab', 'stopwords', 'averaged_perceptron_tagger_eng', 'wordnet', 'omw-1.4'):
    assert nltk.download(name, download_dir=str(root), quiet=True, raise_on_error=True)
# Native RoleMRC resolves directory names, not zip-backed lookup aliases.
import zipfile
for name in ('wordnet', 'omw-1.4'):
    archive = root / 'corpora' / (name + '.zip')
    if archive.is_file():
        with zipfile.ZipFile(archive) as stream:
            stream.extractall(root / 'corpora')
""")
for component in ('resources_servers/ifbench', 'resources_servers/instruction_following', 'resources_servers/voicebench', 'resources_servers/iheval', 'resources_servers/rolemrc'):
    run('nltk-' + component.rsplit('/', 1)[1], component, r"""
import defusedxml.ElementTree
import regex
import nltk
assert nltk.sent_tokenize('One. Two.')
assert nltk.word_tokenize('The cat sat.')
from nltk.corpus import wordnet, stopwords
assert wordnet.synsets('castle')
assert 'the' in stopwords.words('english')
assert nltk.pos_tag(['Write', 'a', 'story'])
""")
