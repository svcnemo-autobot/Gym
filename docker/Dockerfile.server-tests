run('node-codex-launcher', 'responses_api_agents/codex_agent', r"""
import subprocess
from pathlib import Path
from tempfile import TemporaryDirectory
from responses_api_agents.codex_agent.setup_codex import ensure_node
ensure_node()
launcher = Path('responses_api_agents/codex_agent/sandbox_launcher.mjs').resolve()
with TemporaryDirectory() as directory:
    root = Path(directory)
    sessions = root / 'home/.codex/sessions'
    sessions.mkdir(parents=True)
    (sessions / 'rollout.jsonl').write_text('{"id":"probe"}\n')
    subprocess.run(['node', str(launcher), '--snapshot', str(root)], check=True, timeout=15)
    assert (root / 'native_session.jsonl').read_text().strip() == '{"id":"probe"}'
extension = Path('responses_api_agents/pi_agent/runtime-guards.mjs').resolve()
script = "import assert from 'node:assert/strict';\nconst {default: install} = await import(process.argv[1]);\nconst handlers = {};\nprocess.env.NEMO_GYM_PI_BASH_TIMEOUT = '900';\ninstall({on: (name, handler) => {handlers[name] = handler;}});\nconst event = {toolName: 'bash', input: {command: 'echo hello', timeout: 30}};\nhandlers.tool_call(event);\nassert.equal(event.input.timeout, 30);\nassert.ok(handlers.before_agent_start({systemPrompt: 'Probe'}).systemPrompt.includes('900 seconds'));\n"
subprocess.run(['node', '--input-type=module', '-e', script, extension.as_uri()], check=True, timeout=15)
""")
run('miniswe-fresh-runtime', 'responses_api_agents/miniswe_sandboxed_agent', r"""
import os, subprocess, sys
from pathlib import Path
from tempfile import TemporaryDirectory
requirements = Path('responses_api_agents/miniswe_sandboxed_agent/runtime/requirements.txt').resolve()
with TemporaryDirectory() as directory:
    runtime = Path(directory) / 'venv'
    subprocess.run(['uv', '--no-config', 'venv', str(runtime), '--python', sys.executable], check=True)
    python = runtime / 'bin/python'
    subprocess.run(['uv', '--no-config', 'pip', 'install', '--python', str(python), '-r', str(requirements)], check=True)
    subprocess.run([str(python), '-c', 'from minisweagent.run.mini import app; from minisweagent.environments.local import LocalEnvironment; from minisweagent.exceptions import Submitted; import litellm, mcp'], env=os.environ | {'LITELLM_LOCAL_MODEL_COST_MAP': 'true'}, check=True)
    # Run the native adapter once against a loopback Responses endpoint.
    import json, threading
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
    requests = []
    class Handler(BaseHTTPRequestHandler):
        def do_POST(self):
            assert self.path.endswith('/v1/responses'), self.path
            params = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
            requests.append(params)
            payload = {'id': 'resp_runtime', 'created_at': 0, 'object': 'response',
                'model': 'runtime-probe', 'status': 'completed', 'parallel_tool_calls': False,
                'tool_choice': 'auto', 'tools': [], 'output': [{'type': 'function_call',
                    'id': 'fc_runtime', 'call_id': 'call_runtime', 'name': 'bash',
                    'arguments': json.dumps({'command': 'echo COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT'}),
                    'status': 'completed'}],
                'usage': {'input_tokens': 10, 'input_tokens_details': {'cached_tokens': 0},
                    'output_tokens': 3, 'output_tokens_details': {'reasoning_tokens': 0}, 'total_tokens': 13}}
            data = json.dumps(payload).encode()
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.send_header('Content-Length', str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        def log_message(self, *args):
            pass
    server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
    thread = threading.Thread(target=server.serve_forever, daemon=True)
    thread.start()
    try:
        config = Path(directory) / 'config.yaml'
        config.write_text(json.dumps({
            'run': {'task': 'Return the completed runtime probe.'},
            'agent': {'agent_class': 'default', 'step_limit': 2, 'cost_limit': 0},
            'environment': {'environment_class': 'timed_environment.TimedLocalEnvironment',
                'cwd': directory, 'timeout': 10},
            'model': {'model_class': 'litellm_response', 'model_name': 'openai/runtime-probe',
                'cost_tracking': 'ignore_errors', 'model_kwargs': {
                    'api_base': f'http://127.0.0.1:{server.server_port}/v1', 'api_key': 'runtime-probe',
                    'max_retries': 0, 'timeout': 10, 'extra_headers': {'x-session-id': 'runtime-probe'},
                    'extra_body': {'tools': [{'type': 'function', 'name': 'bash',
                        'description': 'Run a local shell command.', 'strict': False,
                        'parameters': {'type': 'object', 'properties': {'command': {'type': 'string'}},
                            'required': ['command']}}]}}}}))
        trajectory = Path(directory) / 'trajectory.json'
        environment = os.environ | {'MSWEA_CONFIGURED': 'true', 'MSWEA_SILENT_STARTUP': 'true',
            'LITELLM_LOCAL_MODEL_COST_MAP': 'true', 'MSWEA_MODEL_RETRY_STOP_AFTER_ATTEMPT': '1',
            'MSWEA_GLOBAL_CONFIG_DIR': str(Path(directory) / 'config')}
        log = ROOT / 'cache/server-test-runtime' / ('miniswe-' + os.environ['UV_OFFLINE'] + '.log')
        with log.open('w') as output:
            completed = subprocess.run([str(python),
                str(ROOT / 'responses_api_agents/miniswe_sandboxed_agent/timed_environment.py'),
                '-c', 'mini.yaml', '-c', str(config), '-o', str(trajectory)],
                cwd=directory, env=environment, stdout=output, stderr=subprocess.STDOUT, timeout=90)
        if completed.returncode:
            print(log.read_text()[-8000:])
        assert completed.returncode == 0, completed.returncode
        assert requests and trajectory.is_file()
        assert 'COMPLETE_TASK_AND_SUBMIT_FINAL_OUTPUT' in trajectory.read_text()
    finally:
        server.shutdown()
        server.server_close()
        thread.join(10)

""")
run('chromium', 'resources_servers/interactive_browser', r"""
from playwright.sync_api import sync_playwright
with sync_playwright() as playwright:
    browser = playwright.chromium.launch(headless=True)
    page = browser.new_page()
    page.set_content('<title>Gym offline probe</title>')
    assert page.title() == 'Gym offline probe'
    browser.close()
""" if offline else r"""
import subprocess, sys
subprocess.run([sys.executable, '-m', 'playwright', 'install', 'chromium'], check=True)
""")
run('libreoffice-real-conversion', 'resources_servers/gdpval', r"""
from pathlib import Path
from tempfile import TemporaryDirectory
from docx import Document
from resources_servers.gdpval import preconvert
from resources_servers.gdpval.setup_libreoffice import ensure_libreoffice
assert ensure_libreoffice()
with TemporaryDirectory() as directory:
    root = Path(directory)
    deliverables = root / 'deliverables'
    deliverables.mkdir()
    document = Document()
    document.add_paragraph('Runtime dependency probe.')
    document.save(deliverables / 'report.docx')
    assert ensure_libreoffice(probe_dirs=[root / 'persist'])
    assert preconvert.preconvert_dir(deliverables) == (1, 0, [])
    assert (deliverables / 'report.pdf').read_bytes().startswith(b'%PDF')
""")
run('native-system-lifecycles', 'environment_servers/swe_together', r"""
import socket, ssl, subprocess, threading, urllib.request
from pathlib import Path
from tempfile import TemporaryDirectory
from environment_servers.swe_together.egress_proxy import RegistryCA
with TemporaryDirectory() as directory:
    root = Path(directory)
    source = root / 'probe.c'
    source.write_text('int main(void) { return 0; }\n')
    binary = root / 'probe'
    subprocess.run(['cc', str(source), '-o', str(binary)], check=True)
    subprocess.run([str(binary)], check=True)
    tmux = ['tmux', '-S', str(root / 'tmux.sock')]
    try:
        subprocess.run([*tmux, 'new-session', '-d', '-s', 'probe', 'sleep 30'], check=True)
        subprocess.run([*tmux, 'has-session', '-t', 'probe'], check=True)
    finally:
        subprocess.run([*tmux, 'kill-server'], check=True)
    ca = RegistryCA(root / 'certificates')
    assert ca.certificate.is_file() and ca.contexts
    host, server_context = next(iter(ca.contexts.items()))
    listener = socket.socket()
    listener.bind(('127.0.0.1', 0))
    listener.listen(1)
    def serve():
        conn, _ = listener.accept()
        with server_context.wrap_socket(conn, server_side=True) as stream:
            assert stream.recv(4) == b'ping'
            stream.sendall(b'pong')
    thread = threading.Thread(target=serve)
    thread.start()
    try:
        context = ssl.create_default_context(cafile=str(ca.certificate))
        with socket.create_connection(listener.getsockname(), timeout=10) as conn:
            with context.wrap_socket(conn, server_hostname=host) as stream:
                stream.sendall(b'ping')
                assert stream.recv(4) == b'pong'
        thread.join(10)
        assert not thread.is_alive()
    finally:
        listener.close()
""")
run('switchyard-native-server', 'responses_api_models/switchyard_model', r"""
import os, socket, urllib.request
from pathlib import Path
from tempfile import TemporaryDirectory
from switchyard_rust.server import Server
os.environ['SWITCHYARD_TEST_API_KEY'] = 'runtime-probe'
with TemporaryDirectory() as directory:
    deployment = Path(directory) / 'routes.toml'
    deployment.write_text('schema_version = 1\n[llm_clients.upstream]\nformat = "openai_chat"\nbase_url = "http://127.0.0.1:9/v1"\napi_key_env = "SWITCHYARD_TEST_API_KEY"\n[targets.policy]\nid = "upstream/model"\nllm_client = "upstream"\n[routes.policy-model]\nid = "policy-model"\ntype = "passthrough"\ntarget = "policy"\n')
    with socket.socket() as sock:
        sock.bind(('127.0.0.1', 0))
        port = sock.getsockname()[1]
    server = Server(str(deployment), port=port)
    try:
        with urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=10) as response:
            assert response.status == 200
    finally:
        server.close()
""")
# Retain actual revisions for native unpinned external clones; never claim they were pinned.
if not offline:
    revisions = {}
    for path in (ROOT / 'NewtonBench', ROOT / 'resources_servers/ether0/.ether0', STATE / 'eternafold/EternaFold'):
        if (path / '.git').exists():
            revisions[str(path)] = subprocess.check_output(['git', '-C', str(path), 'rev-parse', 'HEAD'], text=True).strip()
    (STATE / 'native-resolved-revisions.json').write_text(json.dumps(revisions, indent=2))
assert all(row['status'] == 'passed' for row in results), [row for row in results if row['status'] != 'passed']
print(mode, 'native asset groups passed:', len(results), flush=True)
PY_ASSETS
chown 65532:65532 /opt/nemo-gym/cache/server-test-runtime/native-assets.py
EOF

USER 65532:65532
RUN python -u /opt/nemo-gym/cache/server-test-runtime/native-assets.py prepare
RUN python -u /opt/nemo-gym/cache/server-test-runtime/native-assets.py offline
RUN <<'EOF' bash -eu -o pipefail
for command in cmake gcc g++ make ffmpeg uv python pre-commit node tmux openssl; do command -v "$command"; done
for path in "$HOME" "$UV_CACHE_DIR" "$PRE_COMMIT_HOME" /opt/nemo-gym /opt/nemo-gym/results; do test -w "$path"; done
python -c 'import nemo_gym, hydra, pydantic, pytest; print(nemo_gym.__file__)'
EOF
USER root
