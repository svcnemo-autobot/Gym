# The native CI installer supplies these unpinned Ubuntu packages. Keep its
# resolver behavior and log the actual transaction; reuse every existing cache.
USER 0:0
RUN set -eux; \
    apt-get update; \
    apt-get --simulate install --no-install-recommends --no-upgrade libx11-6 libxext6 libxrender1; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends --no-upgrade libx11-6 libxext6 libxrender1; \
    dpkg-query -W libx11-6 libxext6 libxrender1; \
    rm -rf /var/lib/apt/lists/*
USER 65532:65532
ENV HOME=/home/nemo-runtime UV_CACHE_DIR=/opt/nemo-gym/cache/uv UV_LINK_MODE=copy
WORKDIR /opt/nemo-gym
RUN <<'SH'
set -eu
umask 0022
printf 'Ether0 repaired native consumer probe, uid=%s\n' "$(id -u)"
test "$(id -u)" = 65532
UV_PROJECT_ENVIRONMENT=/tmp/ether0-native-probe uv sync --project resources_servers/ether0 --locked --offline
UV_OFFLINE=1 /tmp/ether0-native-probe/bin/python - <<'PY2'
from pathlib import Path
import os
import tempfile
from rdkit import Chem
from rdkit.Chem.Draw import rdMolDraw2D
from resources_servers.ether0.app import EVAL_FUNCTIONS
assert EVAL_FUNCTIONS
molecule = Chem.MolFromSmiles('CCO')
assert molecule is not None
renderer = rdMolDraw2D.MolDraw2DSVG(240, 180)
renderer.DrawMolecule(molecule)
renderer.FinishDrawing()
assert '<svg' in renderer.GetDrawingText()
for root in (Path.home(), Path(os.environ['UV_CACHE_DIR'])):
    with tempfile.TemporaryFile(dir=root) as f:
        f.write(b'rootless-ready')
print('Ether0 native application import and real RDKit rendering passed offline.')
PY2
rm -rf /tmp/ether0-native-probe
SH
