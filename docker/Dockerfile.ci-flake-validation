# Runtime-only core-test cache repair. Keep out of the product PR.
FROM 766267172432.dkr.ecr.us-east-1.amazonaws.com/nemo-autobot/agent-sandbox@sha256:938d380960caa05c82aa1d321f664bd0a22319bf97e4372519d73572b086f319
# native input nemo_gym/server_runtime/supervisor/_locked_env.py git-blob b2551aa32b818f7e13ac3c38a8e43515964c5836
# native input tests/unit_tests/server_runtime/supervisor/test_locked_env.py git-blob 61abfabaf270b924bbea8354b7a1fc7a157b43b6
# native input tests/unit_tests/agents/test_sandbox_supervisor_bootstrap.py git-blob b2ddbb28655814639273c463106b645d3947515f
# native input responses_api_agents/simple_agent/pyproject.toml git-blob 74e18f81ff2df0da673d4a37dfada03875c8fd6c
# native input responses_api_agents/simple_agent/uv.lock git-blob ec0331531d8569a7c1260bda7f2e43803228ca03
USER 65532:65532
# Host CI has no NGC shell initialization. Preserve restricted-PATH shell tests.
ENV HOME=/home/nemo-runtime UV_CACHE_DIR=/opt/nemo-gym/cache/uv UV_LINK_MODE=copy ENV="" BASH_ENV=""
WORKDIR /opt/nemo-gym
RUN <<'SH'
set -eu
umask 0022
printf 'Prepare native mirror cache, uid=%s\n' "$(id -u)"
test "$(id -u)" = 65532
cd responses_api_agents/simple_agent
uv export --locked --no-dev --output-file /tmp/native-mirror-requirements.txt > /tmp/native-mirror-export.log 2>&1
# The native mirror fixture uses a local index plus this public extra index.
# Seed the latter's metadata namespace without changing native lock versions.
UV_OFFLINE=0 UV_INDEX_URL=http://127.0.0.1:9/ UV_EXTRA_INDEX_URL=https://pypi.org/simple/ UV_HTTP_RETRIES=1 uv venv --seed --python /opt/nemo_gym_venv/bin/python /tmp/mirror-seed
UV_OFFLINE=0 UV_INDEX_URL=http://127.0.0.1:9/ UV_EXTRA_INDEX_URL=https://pypi.org/simple/ UV_HTTP_RETRIES=1 uv pip install --python /tmp/mirror-seed/bin/python --no-deps -r /tmp/native-mirror-requirements.txt
# A fresh environment exercises the actual offline cache, not installed packages.
UV_OFFLINE=1 UV_INDEX_URL=http://127.0.0.1:9/ UV_EXTRA_INDEX_URL=https://pypi.org/simple/ uv venv --seed --python /opt/nemo_gym_venv/bin/python /tmp/mirror-offline
UV_OFFLINE=1 UV_INDEX_URL=http://127.0.0.1:9/ UV_EXTRA_INDEX_URL=https://pypi.org/simple/ uv pip install --python /tmp/mirror-offline/bin/python --no-deps -r /tmp/native-mirror-requirements.txt
/tmp/mirror-offline/bin/python -m pip --version
/tmp/mirror-offline/bin/python - <<'PY2'
import os,shutil,subprocess,tempfile
from pathlib import Path
import nemo_gym, aiohappyeyeballs
with tempfile.TemporaryDirectory() as directory:
    (Path(directory)/'touch').symlink_to(shutil.which('touch'))
    result=subprocess.run([shutil.which('sh'),'-c',':'],env=os.environ|{'PATH':directory},text=True,capture_output=True)
    assert result.returncode==0 and result.stderr=='',result
print('Native mirror seed, full locked export and restricted-PATH shell ready offline.')
PY2
rm -rf /tmp/mirror-seed /tmp/mirror-offline /tmp/native-mirror-requirements.txt /tmp/native-mirror-export.log
SH
