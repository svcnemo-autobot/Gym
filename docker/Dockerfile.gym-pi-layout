subprocess.run(['chown', '-R', '65532:65532', '/opt/gym-runtime/envs/pi_agent'], check=True)
subprocess.run(['find', '/opt/nemo-gym/cache/uv', '!', '-user', '65532', '-exec', 'chown', '65532:65532', '{}', '+'], check=True)
PY
