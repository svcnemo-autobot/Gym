USER root
WORKDIR /opt/nemo-gym
RUN <<'PY' /opt/nemo_gym_venv/bin/python
import hashlib, json, pathlib, shutil, subprocess, urllib.request
prefix = pathlib.Path('/opt/gym-runtime/pi')
archive = pathlib.Path('/tmp/pi-coding-agent-0.80.2.tgz')
url = 'https://registry.npmjs.org/@earendil-works/pi-coding-agent/-/pi-coding-agent-0.80.2.tgz'
with urllib.request.urlopen(url, timeout=120) as response:
    archive.write_bytes(response.read())
assert hashlib.sha256(archive.read_bytes()).hexdigest() == '9cab186615345f3cc2ab1d35f7d6f139306a3122a030a45f7c245489f7349085'
# Standard npm nesting matches the installed-package layout used by native Pi tests.
# Resolver overrides retain the release cohort already pinned by the published shrinkwrap.
shutil.rmtree(prefix)
prefix.mkdir()
(prefix / 'package.json').write_text(json.dumps({
    'private': True,
    'overrides': {f'@earendil-works/{name}': '0.80.2' for name in ['pi-agent-core', 'pi-ai', 'pi-tui']},
}))
subprocess.run(['npm', 'install', '--prefix', str(prefix), '--install-strategy=nested',
                '--ignore-scripts', '--no-audit', '--no-fund', str(archive)], check=True)
archive.unlink()
with (prefix / 'installed-tree.json').open('w') as output:
    subprocess.run(['npm', 'ls', '--prefix', str(prefix), '--all', '--json'], stdout=output, check=True)
subprocess.run(['chown', '-R', '65532:65532', str(prefix)], check=True)
# Seed the unchanged module environment with its native locked installer.
subprocess.run(['/opt/nemo_gym_venv/bin/python', 'nemo_gym/cli/_locked_env.py',
                '--project', '/opt/nemo-gym/responses_api_agents/pi_agent',
