mkdir -p responses_api_agents/rna_design_agent/.eternafold/EternaFold
git -C responses_api_agents/rna_design_agent/.eternafold/EternaFold init -q
for attempt in 1 2; do
    if timeout 180 git -C responses_api_agents/rna_design_agent/.eternafold/EternaFold fetch --depth=1 https://github.com/eternagame/EternaFold.git 87b9aac55cee14fd562049d08f7b92d3131f10ce > /tmp/eterna-fetch.log 2>&1; then
        cat /tmp/eterna-fetch.log; break
