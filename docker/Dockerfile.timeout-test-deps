python -u - <<'PYTHON'
import os, shutil, subprocess, tempfile, time
from pathlib import Path
from nemo_gym.cli.env import TestConfig, _setup_single, get_global_config_dict
roots=['environment_servers','resources_servers','responses_api_agents','responses_api_models']
components=sorted(str(p) for root in roots for p in Path(root).iterdir() if p.is_dir() and (p/'README.md').is_file())[0::8]
assert len(components)==33
cfg=get_global_config_dict()
cfg.uv_cache_dir=os.environ['UV_CACHE_DIR']
def prepare(component):
 for attempt in range(1,3):
  with tempfile.TemporaryFile(mode='w+') as log:
   saved=[os.dup(1),os.dup(2)]
   try:
    os.dup2(log.fileno(),1);os.dup2(log.fileno(),2)
    process=_setup_single(TestConfig(entrypoint=component),cfg)
    result=process.wait(timeout=900)
   finally:
    for fd,original in enumerate(saved,1): os.dup2(original,fd);os.close(original)
   log.seek(0);text=log.read()
  print(f'NATIVE_SETUP {component} attempt={attempt} exit={result}',flush=True)
  if not result: return
  print('\n'.join(text.splitlines()[-70:]),flush=True)
  transient=any(marker in text.lower() for marker in ['timed out','connection reset','connection refused','temporary failure','http 429','http 502','http 503','http 504','remote end hung up','tls connection was non-properly terminated'])
  if attempt==2 or not transient: raise RuntimeError(f'Native setup failed: {component}: {result}')
  time.sleep(2)
with tempfile.TemporaryDirectory(prefix='gym-prep-') as directory:
 cfg.uv_venv_dir=directory
 # Exercise the previously failing exact native setup before repeating the batch.
 ordered=['responses_api_models/switchyard_model']+[p for p in components if p!='responses_api_models/switchyard_model']
 for component in ordered:
  print('PREPARE',component,flush=True)
  prepare(component)
  shutil.rmtree(Path(directory)/component,ignore_errors=True)
 runtime=Path(directory)/'miniswe-native'
 subprocess.run(['uv','--no-config','venv',str(runtime),'--python',__import__('sys').executable],check=True)
 subprocess.run(['uv','--no-config','pip','install','--python',str(runtime/'bin/python'),'-r','responses_api_agents/miniswe_sandboxed_agent/runtime/requirements.txt'],check=True)
 subprocess.run([str(runtime/'bin/python'),'-c','import minisweagent,litellm,mcp; import importlib.metadata as m; assert m.version("mini-swe-agent")=="2.4.6"; assert m.version("litellm")=="1.106.0"; assert m.version("mcp")=="2.2.0"'],check=True)
print('NATIVE_COMPONENT_AND_MINISWE_SEED_OK',flush=True)
PYTHON
