FROM 766267172432.dkr.ecr.us-east-1.amazonaws.com/nemo-autobot/agent-sandbox@sha256:a5d6719c2430637c6576f86e7562d20b6b122a85861feb6787d70e13f95b820e
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
USER root
# Keep the candidate source separate from the base image checkout so newer
# image-only files cannot become candidate consumers. Caches remain inherited.
COPY --chown=65532:65532 . /opt/gym-prereq/source/
WORKDIR /opt/gym-prereq/source
# CPU bootstrap explicitly requires POSIX sh. The CUDA base's sh-wrap selects
# Bash without _CUDA_COMPAT_STATUS. Keep that wrapper and Bash intact, use the
# distro-owned dash for /bin/sh, and do not forge CUDA initialization state.
RUN test "$(readlink -f /bin/sh)" = /usr/bin/sh-wrap && \
    test "$(sha256sum /usr/bin/sh-wrap | cut -d' ' -f1)" = d708a4b32d7366e10d22cfe058fec7b3699dd2d22ae40f7bcf432b256fe9d4fe && \
    test -x /bin/dash && ln -sfn dash /bin/sh && \
    install -d -o 65532 -g 65532 /opt/gym-prereq /opt/gym-prereq/envs /opt/gym-prereq/reports
# Refresh signed package indexes before resolving; the release image strips them.
# The native installer leaves OS versions to this resolver. Save its proposal.
RUN apt-get update && /opt/nemo_gym_venv/bin/python - <<'PY_OS'
import subprocess
from resources_servers.gdpval.setup_libreoffice import _APT_PACKAGES
packages = [*_APT_PACKAGES, 'tmux']
with open('/opt/gym-prereq/reports/apt-proposed.txt', 'w') as stream:
    subprocess.run(['apt-get', '-s', 'install', '--no-install-recommends', *packages], stdout=stream, stderr=subprocess.STDOUT, check=True)
subprocess.run(['apt-get', 'install', '-y', '--no-install-recommends', *packages], check=True)
with open('/opt/gym-prereq/reports/installed-packages.txt', 'w') as stream:
    subprocess.run(['dpkg-query', '-W', *packages], stdout=stream, check=True)
PY_OS
USER 65532:65532
RUN <<'PY_ENV' /opt/nemo_gym_venv/bin/python
import os, pathlib, subprocess, sys
from nemo_gym.cli._locked_env import sync_environment
root = pathlib.Path('/opt/gym-prereq/source')
envs = pathlib.Path('/opt/gym-prereq/envs')
# Seed the benchmark interpreter through native server setup first so its dev
# test tools remain present under the native inexact benchmark sync.
sync_environment(root/'resources_servers/long_transduction', envs/'benchmarks__long_transduction', sys.executable, [], [])
for component in ['benchmarks/long_transduction', 'resources_servers/gdpval', 'resources_servers/gdp_pdf', 'resources_servers/indian_banking', 'resources_servers/terminal_bench_2_1', 'resources_servers/vibench', 'responses_api_agents/kilocode_agent', 'responses_api_agents/terminus_2_sandboxed_agent']:
    target = envs / component.replace('/', '__')
    sync_environment(root / component, target, sys.executable, [], [])
# ViBench documents Jinja2 in its preparation interpreter; do not alter its lock.
# Use the root lock's pin only in this explicit preparation environment.
subprocess.run(['uv', 'pip', 'install', '--python', str(envs/'resources_servers__vibench/bin/python'), 'jinja2==3.1.6'], check=True)
# Populate the real tokenizer disk cache via the locked preparation interpreter.
subprocess.run([str(envs/'benchmarks__long_transduction/bin/python'), '-c', 'import tiktoken,wonderwords; assert tiktoken.get_encoding("cl100k_base").encode("Gym readiness")'], check=True)
PY_ENV
RUN <<'PY_DATA' /opt/nemo_gym_venv/bin/python
import os, pathlib, subprocess
os.environ['HF_HUB_OFFLINE'] = '0'
os.environ['HF_DATASETS_OFFLINE'] = '0'
from huggingface_hub import hf_hub_download, HfApi
root = pathlib.Path('/opt/gym-prereq/source')
# Native README downloads have no revision argument. Preserve that behavior and
# record the resolved repository identity rather than inventing a native pin.
for repo in ['Oitaaa/GDP.pdf', 'NPCI/nemo-gym-indian-banking']:
    info = HfApi().dataset_info(repo)
    with open('/opt/gym-prereq/reports/' + repo.replace('/', '__') + '.revision', 'w') as stream:
        stream.write(info.sha + '\n')
for name in ['db.json', 'kb.json']:
    hf_hub_download('NPCI/nemo-gym-indian-banking', name, repo_type='dataset', local_dir=root/'resources_servers/indian_banking/data')
subprocess.run(['/opt/gym-prereq/envs/resources_servers__gdp_pdf/bin/python', '-c', 'from benchmarks.gdp_pdf.prepare import fetch_example_media, RS_DATA_DIR; print(fetch_example_media(RS_DATA_DIR))'], check=True)
subprocess.run(['/opt/nemo_gym_venv/bin/python', '-m', 'benchmarks.terminal_bench_2_1.prepare_inkling_small'], check=True)
