RUN chown root:root /opt/nemo-gym && UV_OFFLINE=0 uv sync --locked --extra dev
ENV PATH=/opt/gym-validation-driver/bin:/usr/local/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/mpi/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
# Bound uv transport recovery without changing native manifests, pins or setup.
ENV UV_HTTP_RETRIES=3 UV_HTTP_TIMEOUT=60
# Warm the two external-archive environments through unchanged native setup.
# The pinned nooa archive returned HTTP 503 after uv's three HTTP retries.
# Allow one bounded identical native setup replay only for a recorded transport
# failure, then require a fresh offline install; do not retry deterministic errors.
RUN <<'SH'
UV_OFFLINE=0 python -u - <<'PY'
import re
import subprocess
from pathlib import Path
from nemo_gym.cli.env import TestConfig, _setup_single
from nemo_gym.config.global_config import get_global_config_dict
reports = Path('/opt/nemo-gym/cache/validation-reports/targeted-seed')
reports.mkdir(parents=True, exist_ok=True)
config = get_global_config_dict()
config.uv_venv_dir = '/tmp/gym-targeted-seed'
failed = []
for component in ('resources_servers/instruction_following', 'responses_api_agents/nooa_agent'):
    for attempt in (1, 2):
        log = reports / f"{component.replace('/', '__')}-{attempt}.log"
        print('START native-archive-setup', component, attempt, flush=True)
        with log.open('w') as output:
            command = [
                '/opt/gym-validation-driver/bin/python', '-u', '-c',
                'from nemo_gym.cli.env import TestConfig, _setup_single; '
                'from nemo_gym.config.global_config import get_global_config_dict; '
                f'c=get_global_config_dict(); c.uv_venv_dir={config.uv_venv_dir!r}; '
                f'raise SystemExit(_setup_single(TestConfig(entrypoint={component!r}), c).wait())',
            ]
            try:
                result = subprocess.run(command, stdout=output, stderr=subprocess.STDOUT, timeout=300)
                status = result.returncode
            except subprocess.TimeoutExpired:
                status = 124
        text = log.read_text()
        print(text, end='', flush=True)
        print('TARGETED_NATIVE_SETUP_EXIT', component, attempt, status, flush=True)
        if status == 0:
            break
        transient = bool(re.search(r'HTTP status server error \(5[0-9]{2}|429 Too Many Requests|connection reset|connection timed out', text, re.I))
        if attempt == 2 or not transient:
            failed.append(component)
            break
if failed:
    raise RuntimeError(f'Native dependency setup failed after bounded recovery: {failed}')
PY
rm -rf /tmp/gym-targeted-seed
SH
# Keep the large package seed independent of lazy asset preparation.
RUN <<'SH'
mkdir -p /opt/nemo-gym/cache/validation-reports
printf 'START native-server-environment-seed\n'
status=0
UV_OFFLINE=0 ng_test_all +setup_only=true +delete_venvs_after_each_test=true \
    +uv_cache_dir=/opt/nemo-gym/cache/uv +uv_venv_dir=/tmp/gym-server-seed \
    2>&1 | tee /opt/nemo-gym/cache/validation-reports/server-seed.log || status=$?
printf 'NATIVE_SERVER_ONLINE_SEED_EXIT=%s\n' "$status"
rm -rf /tmp/gym-server-seed
# An online sync can fail when revalidating an already cached immutable archive.
# Require every native environment to install from that cache with egress disabled;
# this is the actual shard prerequisite and cannot hide an uncached dependency.
offline_status=0
UV_OFFLINE=1 ng_test_all +setup_only=true +delete_venvs_after_each_test=true \
    +uv_cache_dir=/opt/nemo-gym/cache/uv +uv_venv_dir=/tmp/gym-server-offline-seed \
    2>&1 | tee /opt/nemo-gym/cache/validation-reports/server-offline-seed.log || offline_status=$?
printf 'NATIVE_SERVER_OFFLINE_SEED_EXIT=%s\n' "$offline_status"
test "$offline_status" = 0
rm -rf /tmp/gym-server-offline-seed
