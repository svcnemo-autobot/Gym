ENV UV_CACHE_DIR=/opt/nemo-gym/cache/uv \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/gym-validation-driver \
    XDG_CACHE_HOME=/opt/nemo-gym/cache/xdg \
