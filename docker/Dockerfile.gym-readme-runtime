    probe.write_text('probe')
    probe.unlink()
subprocess.run(['/opt/gym-runtime/envs/chemcotbench/bin/python', '-c', 'from resources_servers.chemcotbench.setup_upstream import ensure_data; p=ensure_data(None); assert (p/"manifest.json").is_file(); print(p)'], check=True)
from resources_servers.mimo_music.setup_abc2midi import ensure_abc2midi
assert ensure_abc2midi() == '/opt/gym-runtime/bin/abc2midi'
subprocess.run(['abc2midi', '-ver'], check=True)
# Exercise the installed renderer, not only its version or presence.
import tempfile
with tempfile.TemporaryDirectory() as directory:
    source = pathlib.Path(directory) / 'probe.abc'
    output = pathlib.Path(directory) / 'probe.mid'
    source.write_text('X:1\nT:Offline readiness\nM:4/4\nL:1/8\nK:C\nC2 E2 G2 c2 |\n')
    subprocess.run(['abc2midi', str(source), '-o', str(output)], check=True)
    assert output.read_bytes().startswith(b'MThd')
subprocess.run(['/opt/gym-runtime/envs/interactive_browser/bin/python', '-c', 'from playwright.sync_api import sync_playwright; p=sync_playwright().start(); b=p.chromium.launch(headless=True,args=["--no-sandbox"]); page=b.new_page(); page.set_content("<title>Gym offline</title>"); assert page.title()=="Gym offline"; b.close(); p.stop()'], check=True)
