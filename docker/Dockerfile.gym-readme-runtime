RUN <<'PY' /opt/nemo_gym_venv/bin/python
import os, pathlib, shutil, subprocess
assert os.getuid() == 65532
# The fixture calls ensure_data(None); populate the native pinned hub snapshot.
chem = '/opt/gym-runtime/envs/chemcotbench/bin/python'
subprocess.run([chem, '-c', 'from resources_servers.chemcotbench.setup_upstream import ensure_data; print(ensure_data(None))'], env=dict(os.environ, HF_HUB_OFFLINE='0'), check=True)
# The README requires the real pinned renderer on PATH for offline operation.
# Its unchanged installer checks the source archive and builds abc2midi 4.88.
from resources_servers.mimo_music.setup_abc2midi import ensure_abc2midi
binary = pathlib.Path(ensure_abc2midi())
shutil.copy2(binary, '/opt/gym-runtime/bin/abc2midi')
subprocess.run(['/opt/gym-runtime/bin/abc2midi', '-ver'], check=True)
PY
RUN --network=none <<'PY' /opt/nemo_gym_venv/bin/python
import os, pathlib, subprocess
os.environ['HF_HUB_OFFLINE'] = '1'
assert os.getuid() == 65532 and os.environ['HOME'] == '/home/nemo-runtime'
for root in ['/home/nemo-runtime', '/opt/nemo-gym/cache/uv', '/opt/nemo-gym/cache/xdg', '/opt/nemo-gym/results', '/opt/gym-runtime/bin', '/opt/nemo-gym/cache/huggingface/hub']:
