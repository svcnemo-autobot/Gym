uv python install 3.13.14
if UV_PROJECT_ENVIRONMENT=/opt/aut2815/driver uv sync --locked --extra dev > /opt/aut2815/reports/driver.log 2>&1; then
    echo 'NATIVE_DRIVER_SETUP_OK'
