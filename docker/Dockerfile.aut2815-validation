DRIVER
RUN <<'SEED' /opt/aut2815/driver/bin/python -u
import json,os,signal,subprocess,sys,time,re
from pathlib import Path
R=Path('/opt/aut2815/source');os.chdir(R);sys.path.insert(0,str(R))
sys.argv=['prepare','+uv_cache_dir=/opt/nemo-gym/cache/uv','+uv_venv_dir=/opt/aut2815/envs']
from nemo_gym.config.global_config import get_global_config_dict
from nemo_gym.orchestration.server_venv import setup_env_command,run_command,get_venv_path
from nemo_gym.cli.env import _delete_server_venv
cfg=get_global_config_dict()
assert cfg['python_version']=='3.13.14'
assert cfg['uv_cache_dir']=='/opt/nemo-gym/cache/uv' and cfg['uv_venv_dir']=='/opt/aut2815/envs'
modules=sorted(str(p.relative_to(R)) for kind in ['environment_servers','resources_servers','responses_api_agents','responses_api_models'] for p in (R/kind).iterdir() if p.is_dir() and (p/'README.md').is_file() and 'pycache' not in p.name and not p.name.endswith(('.egg-info','.dist-info')))
selected=[n for i,n in enumerate(modules) if i%8 in (3,7)]
assert len(modules)==259 and len(selected)==64
keep=set()  # Seed stage retains caches, not disposable probe environments.
reports=[]
for phase in ['online','offline']:
 if phase=='offline':os.environ['UV_OFFLINE']='1'
 else:os.environ.pop('UV_OFFLINE',None)
 for name in selected:
  status=1
  for attempt in range(1,4 if phase=='online' else 2):
   log=Path('/opt/aut2815/reports')/(name.replace('/','__')+'.'+phase+'.'+str(attempt)+'.log')
   component=R/name
   command=setup_env_command(component,cfg,name.replace('/',r'\/'))
   started=time.monotonic()
   with log.open('w') as f:
    proc=run_command(command,component,project_root=R,global_config_dict=cfg,stdout_target=f,stderr_target=f,start_new_session=True)
    try:status=proc.wait(timeout=240)
    except subprocess.TimeoutExpired:
     os.killpg(proc.pid,signal.SIGTERM)
     try:proc.wait(timeout=10)
     except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL);proc.wait()
     status=124
   tail=log.read_text(errors='replace')[-5000:]
   report={'component':name,'phase':phase,'attempt':attempt,'exit_code':status,'duration_seconds':round(time.monotonic()-started,2),'log':str(log)}
   print(json.dumps(report),flush=True)
   if status==0:break
   print(tail,flush=True)
   transient=bool(re.search(r'timed out|connection reset|\b(?:502|503|504|429)\b|temporary failure',tail,re.I))
   if not transient:break
  reports.append(report)
  Path('/opt/aut2815/reports/native-setups.json').write_text(json.dumps(reports,indent=2))
  if status:raise RuntimeError(f'Native setup failed: {name} {phase}')
  if phase=='online' or name not in keep:_delete_server_venv(component,cfg)
print('NATIVE_SELECTED_ONLINE_AND_OFFLINE_SETUP_OK',flush=True)

SEED

