records=[]
def execute(command,component,label,budget,online=False):
 log=REPORT/(label+'.log');started=time.monotonic()
 with log.open('w') as f:
  proc=run_command(command,component,project_root=R,global_config_dict=cfg,stdout_target=f,stderr_target=f,start_new_session=True,extra_env={'UV_OFFLINE':'0' if online else '1'})
  try:code=proc.wait(timeout=budget)
  except subprocess.TimeoutExpired:
   os.killpg(proc.pid,signal.SIGTERM)
   try:proc.wait(timeout=10)
   except subprocess.TimeoutExpired:os.killpg(proc.pid,signal.SIGKILL);proc.wait()
   code=124
 report={'step':label,'exit_code':code,'duration_seconds':round(time.monotonic()-started,3),'log':str(log)}
 records.append(report);(REPORT/'results.json').write_text(json.dumps(records,indent=2));print(json.dumps(report),flush=True)
 if code:print(log.read_text(errors='replace')[-5000:],flush=True)
 return code,log
for key,name in COMPONENTS.items():
 component=R/name
 try:
  code,_=execute(setup_env_command(component,cfg,name.replace('/',r'\/')),component,key+'-setup',240)
  if code:raise RuntimeError('Offline native setup failed: '+name)
  interpreter=get_venv_path(component,cfg)/'bin/python'
  metadata_dirs=[p for p in component.rglob('*.egg-info') if p.is_dir() and '.venv' not in p.parts]
  for directory in [Path.home(),Path(cfg['uv_cache_dir']),get_venv_path(component,cfg),component,*metadata_dirs]:
   marker=directory/'.aut2815-write-probe';marker.write_text('ready');marker.unlink()
  if key in ('nltk','rna'):
   acquisition=REPORT/('aut2815_acquire_'+key+'.py');acquisition.write_text(ACQUISITION[key])
   for attempt in range(1,4):
    code,log=execute(shlex.join([str(interpreter),'-u',str(acquisition)]),component,key+'-assets-'+str(attempt),300,online=True)
    if code==0:break
    if not re.search(r'timed out|connection reset|\b(?:429|502|503|504)\b|temporary failure',log.read_text(errors='replace'),re.I):break
   if code:raise RuntimeError('Pinned acquisition failed: '+key)
  script=REPORT/('aut2815_probe_'+key.replace('-','_')+'.py');script.write_text(PROBES[key])
  code,_=execute(shlex.join([str(interpreter),'-u',str(script)]),component,key+'-consumer',120)
  if code:raise RuntimeError('Offline consumer failed: '+key)
 finally:_delete_server_venv(component,cfg)
