# syntax=docker/dockerfile:1
# Validation-only extension; not part of the product PR.
# Source/setup/lock Git blobs are recorded below. Native component setup is unchanged.
FROM 766267172432.dkr.ecr.us-east-1.amazonaws.com/gym@sha256:7e3c83cd9458f12216f39c4088a554ef24e38f20f487c84fb9376aa7f543ce99
USER root
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]
WORKDIR /opt/nemo-gym
# Use the native CI package list and resolver rather than independently pinning companions.
RUN export DEBIAN_FRONTEND=noninteractive; \
    packages="$(sed -n '/^packages=(/,/^)/p' scripts/ci/install_test_dependencies.sh | sed '1d;$d')"; \
    apt-get update && apt-get install -y --no-install-recommends ${packages} && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
USER 65532:65532
ENV HOME=/home/nemo-runtime XDG_CACHE_HOME=/opt/nemo-gym/cache/xdg
# NGC's /bin/sh wrapper dispatches to dash with this supported status binding,
# matching the Ubuntu host where the server tests run.
ENV _CUDA_COMPAT_STATUS=0
RUN mkdir -p /opt/nemo-gym/cache/pi-validation-evidence
# The CI image seeded only the root lock, not the selected components' own locks.
# Retain complete output in the successful image; keep published output bounded.
RUN <<'BASH'
echo 'STAGE selected native component cache seeding'
export UV_OFFLINE=0 UV_NO_SYNC=0 UV_LINK_MODE=copy
seed_root=$(mktemp -d)
trap 'rm -rf "$seed_root"' EXIT
status=0
timeout 2400s ng_test_all +setup_only=true +num_shards=8 +shard_index=1 \
    +delete_venvs_after_each_test=true "+uv_cache_dir=${UV_CACHE_DIR}" "+uv_venv_dir=${seed_root}" \
    > /opt/nemo-gym/cache/pi-validation-evidence/setup-online.log 2>&1 || status=$?
if (( status != 0 )); then
    grep -E 'error:|cause:|failed|Failed|^- ' /opt/nemo-gym/cache/pi-validation-evidence/setup-online.log | tail -100 || true
    echo "STAGE selected native component cache seeding EXIT=$status"
    exit "$status"
fi
tail -8 /opt/nemo-gym/cache/pi-validation-evidence/setup-online.log
echo 'STAGE selected native component cache seeding EXIT=0'
BASH
# Prepare the one real lazy model consumer in the selected tests through its native API.
# COMET/GloT-LID, sandbox images and scientific grading are mocked by these unit tests.
ENV SACREBLEU=/opt/nemo-gym/cache/sacrebleu
RUN <<'BASH'
echo 'STAGE FLORES-200 native tokenizer preparation'
export UV_OFFLINE=0 UV_NO_SYNC=0
uv venv /tmp/gym-wmt-probe
UV_PROJECT_ENVIRONMENT=/tmp/gym-wmt-probe uv sync --locked --project resources_servers/wmt_translation --no-dev --inexact > /opt/nemo-gym/cache/pi-validation-evidence/wmt-setup.log 2>&1
/tmp/gym-wmt-probe/bin/python - <<'PY'
from sacrebleu.metrics import BLEU
metric=BLEU(tokenize='flores200',effective_order=True)
assert metric.sentence_score('hello world',['hello world']).score > 99
print('FLORES-200 prepared through locked SacreBLEU')
PY
rm -rf /tmp/gym-wmt-probe
echo 'STAGE FLORES-200 native tokenizer preparation EXIT=0'
BASH
# Prove fresh native environment replacement offline as the actual runtime user.
RUN <<'BASH'
echo 'STAGE offline native setup and writable runtime preflight'
export UV_OFFLINE=1 UV_NO_SYNC=0 UV_LINK_MODE=copy
seed_root=$(mktemp -d)
trap 'rm -rf "$seed_root"' EXIT
status=0
timeout 2400s ng_test_all +setup_only=true +num_shards=8 +shard_index=1 \
    +delete_venvs_after_each_test=true "+uv_cache_dir=${UV_CACHE_DIR}" "+uv_venv_dir=${seed_root}" \
    > /opt/nemo-gym/cache/pi-validation-evidence/setup-offline.log 2>&1 || status=$?
if (( status != 0 )); then tail -90 /opt/nemo-gym/cache/pi-validation-evidence/setup-offline.log; exit "$status"; fi
python - <<'PY'
import os,tempfile,pathlib,subprocess,ctypes
assert os.getuid()==65532
for root in [os.environ['HOME'],os.environ['UV_CACHE_DIR'],os.environ['XDG_CACHE_HOME'],'/opt/nemo-gym/cache','/opt/nemo-gym']:
 p=pathlib.Path(root,'.pi-validation-write');p.write_text('x');p.unlink()
for lib in ['libGL.so.1','libSM.so.6','libXext.so.6','libXrender.so.1']:ctypes.CDLL(lib)
assert subprocess.check_output(['/bin/sh','-c','printf %s "$0"'],text=True)=='/bin/dash'
with tempfile.TemporaryDirectory() as d:
 p=pathlib.Path(d,'old');p.write_text('x')
 with p.open('a') as f:f.flush();os.fsync(f.fileno())
 p.rename(pathlib.Path(d,'new'))
print('runtime UID, paths, native libraries, dash dispatch and flush/rename passed')
PY
tail -8 /opt/nemo-gym/cache/pi-validation-evidence/setup-offline.log
echo 'STAGE offline native setup EXIT=0'
BASH
USER root

